---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const models = (await getCollection('models'))
  .filter((m) => typeof m.data.learning_order === 'number')
  .sort((a, b) => (a.data.learning_order ?? 99) - (b.data.learning_order ?? 99));

function fmtTime(minutes: number): string {
  const h = Math.floor(minutes / 60);
  const m = minutes % 60;
  return h > 0 ? (m > 0 ? `~${h}h ${m}m` : `~${h}h`) : `~${m}m`;
}

function imgSrc(path: string) {
  return `${base.slice(0, -1)}${path}`;
}
---

<Base
  title="Start here"
  description="10 prints, one skill at a time — the beginner curriculum for getting started in 3D printing."
>
  <div class="mx-auto max-w-content px-4 md:px-8 lg:px-12 py-12">
    <header class="mb-10 max-w-xl">
      <h1 class="font-display text-3xl font-semibold text-ink mb-3">Start here</h1>
      <p class="text-neutral-500 text-lg leading-relaxed">
        10 prints, one skill at a time. Each step builds on the last — start at #1
        and work down. Skip ahead if you already know the skill; come back if a
        later print fails for a reason an earlier one would have caught.
      </p>
    </header>

    <ol class="relative border-l border-neutral-200 pl-10 space-y-10">
      {models.map((model) => (
        <li class="relative">
          <span
            class={`absolute -left-[2.25rem] top-1 w-8 h-8 rounded-full flex items-center justify-center text-sm font-display font-semibold ${
              model.data.commercial_use === false
                ? 'bg-yellow-50 text-yellow-900 border border-yellow-300'
                : 'bg-accent-soft text-accent border border-accent-soft'
            }`}
            aria-hidden="true"
          >
            {model.data.learning_order}
          </span>

          <a
            href={`${base}models/${model.slug}/`}
            class="group block border border-neutral-100 rounded-lg overflow-hidden hover:border-accent-soft hover:bg-neutral-50 transition-colors"
            aria-label={`Step ${model.data.learning_order}: ${model.data.title}`}
          >
            <div class="flex flex-col sm:flex-row gap-4">
              <div class="aspect-square w-full sm:w-40 sm:h-40 shrink-0 bg-neutral-50 overflow-hidden">
                <img
                  src={imgSrc(model.data.image)}
                  alt={model.data.title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  width="160"
                  height="160"
                />
              </div>
              <div class="flex-1 p-4 sm:pl-0 sm:py-4 sm:pr-4 flex flex-col gap-2">
                <div class="flex items-baseline justify-between gap-3 flex-wrap">
                  <h2 class="font-display font-semibold text-lg text-ink group-hover:text-accent transition-colors leading-snug">
                    {model.data.title}
                  </h2>
                  <span class="text-xs text-neutral-500 shrink-0">
                    {model.data.difficulty} · {fmtTime(model.data.est_print_time_minutes)}
                  </span>
                </div>
                <p class="text-sm text-neutral-700">
                  <strong class="text-ink">Skill: </strong>
                  {model.data.learning_skill ?? model.data.description}
                </p>
                {model.data.commercial_use === false && (
                  <span
                    class="text-xs px-2 py-0.5 rounded font-semibold bg-yellow-50 text-yellow-900 border border-yellow-300 self-start"
                    aria-label="Non-commercial use only"
                  >
                    Non-commercial
                  </span>
                )}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ol>

    <div class="mt-12 border-t border-neutral-100 pt-8">
      <p class="text-sm text-neutral-500">
        Not sure where to dive in?
        <a href={`${base}guide/01-what-is-3d-printing/`} class="text-accent hover:opacity-80 underline underline-offset-2">
          Read the first guide topic
        </a>
        first; the curriculum makes more sense once you know the vocabulary.
      </p>
    </div>
  </div>
</Base>
