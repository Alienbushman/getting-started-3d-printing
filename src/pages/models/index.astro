---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const models = (await getCollection('models')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

function timeBucket(minutes: number): string {
  if (minutes < 30) return 'lt30';
  if (minutes < 60) return '30-60';
  if (minutes < 120) return '60-120';
  return 'gt120';
}

function imgSrc(path: string) {
  return `${base.slice(0, -1)}${path}`;
}

function fmtTime(minutes: number): string {
  const h = Math.floor(minutes / 60);
  const m = minutes % 60;
  return h > 0 ? (m > 0 ? `~${h}h ${m}m` : `~${h}h`) : `~${m}m`;
}
---

<Base
  title="Model Gallery"
  description="Ten beginner-friendly 3D printable models — license-clean, no exotic filament required."
>
  <div class="mx-auto max-w-content px-4 md:px-8 lg:px-12 py-12">
    <h1 class="font-display text-3xl font-semibold text-ink mb-2">Model Gallery</h1>
    <p class="text-neutral-500 mb-8">{models.length} models, all beginner-friendly.</p>

    <!-- Filters + sort -->
    <div class="flex flex-wrap gap-3 items-center mb-3" role="group" aria-label="Filter models">
      <!-- Difficulty -->
      <div class="flex gap-1.5 flex-wrap" role="group" aria-label="Difficulty filter">
        <button data-filter="difficulty" data-value="all" aria-pressed="true"
          class="filter-chip text-xs font-semibold border rounded px-2.5 py-1 transition-colors cursor-pointer">
          All
        </button>
        <button data-filter="difficulty" data-value="beginner" aria-pressed="false"
          class="filter-chip text-xs font-semibold border rounded px-2.5 py-1 transition-colors cursor-pointer">
          Beginner
        </button>
        <button data-filter="difficulty" data-value="intermediate" aria-pressed="false"
          class="filter-chip text-xs font-semibold border rounded px-2.5 py-1 transition-colors cursor-pointer">
          Intermediate
        </button>
      </div>

      <span class="text-neutral-300 hidden sm:inline" aria-hidden="true">·</span>

      <!-- Supports -->
      <button data-filter="supports" data-value="no" aria-pressed="false"
        class="filter-chip text-xs font-semibold border rounded px-2.5 py-1 transition-colors cursor-pointer">
        No supports
      </button>

      <span class="text-neutral-300 hidden sm:inline" aria-hidden="true">·</span>

      <!-- Print time -->
      <div class="flex gap-1.5 flex-wrap" role="group" aria-label="Print time filter">
        <button data-filter="time" data-value="all" aria-pressed="true"
          class="filter-chip text-xs font-semibold border rounded px-2.5 py-1 transition-colors cursor-pointer">
          Any time
        </button>
        <button data-filter="time" data-value="lt30" aria-pressed="false"
          class="filter-chip text-xs font-semibold border rounded px-2.5 py-1 transition-colors cursor-pointer">
          &lt; 30 min
        </button>
        <button data-filter="time" data-value="30-60" aria-pressed="false"
          class="filter-chip text-xs font-semibold border rounded px-2.5 py-1 transition-colors cursor-pointer">
          30–60 min
        </button>
        <button data-filter="time" data-value="60-120" aria-pressed="false"
          class="filter-chip text-xs font-semibold border rounded px-2.5 py-1 transition-colors cursor-pointer">
          1–2 h
        </button>
        <button data-filter="time" data-value="gt120" aria-pressed="false"
          class="filter-chip text-xs font-semibold border rounded px-2.5 py-1 transition-colors cursor-pointer">
          2+ h
        </button>
      </div>
    </div>

    <!-- Sort -->
    <div class="flex items-center gap-2 mb-8">
      <span class="text-xs text-neutral-500">Sort:</span>
      <select id="gallery-sort" aria-label="Sort models" class="text-xs border border-neutral-100 rounded px-2 py-1 text-neutral-900 bg-white cursor-pointer hover:border-accent focus:outline-none focus:border-accent">
        <option value="alpha">A–Z</option>
        <option value="time-asc">Print time ↑</option>
        <option value="time-desc">Print time ↓</option>
        <option value="diff-asc">Easiest first</option>
        <option value="diff-desc">Hardest first</option>
      </select>
    </div>

    <!-- Card grid -->
    <div id="gallery-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" aria-live="polite" aria-label="Model cards">
      {models.map((model) => (
        <div
          data-card
          data-difficulty={model.data.difficulty}
          data-supports={model.data.supports_required ? 'yes' : 'no'}
          data-time={timeBucket(model.data.est_print_time_minutes)}
          data-minutes={model.data.est_print_time_minutes}
          data-commercial={model.data.commercial_use === false ? 'no' : 'yes'}
          data-title={model.data.title}
        >
          <a
            href={`${base}models/${model.slug}/`}
            class="group flex flex-col border border-neutral-100 rounded-lg overflow-hidden hover:border-accent-soft hover:bg-neutral-50 transition-colors h-full"
            aria-label={`${model.data.title} — ${model.data.difficulty}, ${fmtTime(model.data.est_print_time_minutes)} print`}
          >
            <div class="aspect-square bg-neutral-50 overflow-hidden">
              <img
                src={imgSrc(model.data.image)}
                alt={model.data.title}
                class="w-full h-full object-cover"
                loading="lazy"
                width="400"
                height="400"
              />
            </div>
            <div class="p-4 flex-1 flex flex-col gap-2">
              <h2 class="font-display font-semibold text-lg text-ink group-hover:text-accent transition-colors leading-snug">
                {model.data.title}
              </h2>
              <p class="text-sm text-neutral-500 leading-relaxed flex-1">{model.data.description}</p>
              <div class="flex flex-wrap gap-2 items-center mt-1">
                <span class={`text-xs px-2 py-0.5 rounded font-semibold ${model.data.difficulty === 'beginner' ? 'bg-accent-soft text-accent' : 'bg-neutral-100 text-neutral-500'}`}>
                  {model.data.difficulty}
                </span>
                <span class="text-xs text-neutral-500">{fmtTime(model.data.est_print_time_minutes)}</span>
                {!model.data.supports_required && (
                  <span class="text-xs border border-neutral-100 text-neutral-500 rounded px-2 py-0.5">no supports</span>
                )}
                {model.data.commercial_use === false && (
                  <span
                    class="text-xs px-2 py-0.5 rounded font-semibold bg-yellow-50 text-yellow-900 border border-yellow-300"
                    aria-label="Non-commercial use only"
                  >
                    Non-commercial
                  </span>
                )}
                {(model.data.skill_tags ?? []).slice(0, 1).map((tag) => (
                  <span class="text-xs border border-neutral-100 text-neutral-500 rounded px-2 py-0.5">{tag.replace(/-/g, ' ')}</span>
                ))}
              </div>
            </div>
          </a>
        </div>
      ))}
    </div>

    <!-- Empty state -->
    <div id="gallery-empty" class="hidden py-16 text-center">
      <p class="text-neutral-500 mb-4">No models match those filters.</p>
      <button id="gallery-reset" class="text-sm text-accent border border-accent rounded px-4 py-2 hover:bg-accent-soft transition-colors">
        Reset filters
      </button>
    </div>
  </div>
</Base>

<style>
  .filter-chip {
    border-color: #E5E2DC;
    color: #6B675F;
    background: white;
  }
  .filter-chip[aria-pressed="true"] {
    border-color: #E85D2F;
    color: #E85D2F;
    background: #FCE4D6;
  }
  .filter-chip:hover {
    border-color: #E85D2F;
    color: #E85D2F;
  }
  [data-card][data-hidden] {
    display: none;
  }
</style>

<script>
  type Filters = {
    difficulty: string;
    supports: string | null;
    time: string;
  };

  const grid = document.getElementById('gallery-grid')!;
  const emptyState = document.getElementById('gallery-empty')!;
  const resetBtn = document.getElementById('gallery-reset')!;
  const sortSelect = document.getElementById('gallery-sort') as HTMLSelectElement;

  const cards = () => Array.from(grid.querySelectorAll<HTMLElement>('[data-card]'));

  let state: Filters = { difficulty: 'all', supports: null, time: 'all' };

  function readUrlState() {
    const p = new URLSearchParams(location.search);
    state.difficulty = p.get('difficulty') || 'all';
    state.supports = p.get('supports') || null;
    state.time = p.get('time') || 'all';
    if (sortSelect) sortSelect.value = p.get('sort') || 'alpha';
  }

  function pushUrlState() {
    const p = new URLSearchParams();
    if (state.difficulty !== 'all') p.set('difficulty', state.difficulty);
    if (state.supports) p.set('supports', state.supports);
    if (state.time !== 'all') p.set('time', state.time);
    if (sortSelect?.value !== 'alpha') p.set('sort', sortSelect.value);
    const qs = p.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function applyChipState() {
    document.querySelectorAll<HTMLElement>('[data-filter]').forEach((btn) => {
      const filter = btn.dataset.filter as keyof Filters;
      const value = btn.dataset.value!;
      let active = false;
      if (filter === 'difficulty') active = state.difficulty === value;
      else if (filter === 'time') active = state.time === value;
      else if (filter === 'supports') active = state.supports === value;
      btn.setAttribute('aria-pressed', String(active));
    });
  }

  function applyVisibility() {
    let visible = 0;
    cards().forEach((card) => {
      const diff = card.dataset.difficulty!;
      const sup = card.dataset.supports!;
      const time = card.dataset.time!;

      const show =
        (state.difficulty === 'all' || diff === state.difficulty) &&
        (state.supports === null || sup === state.supports) &&
        (state.time === 'all' || time === state.time);

      card.toggleAttribute('data-hidden', !show);
      if (show) visible++;
    });
    emptyState.classList.toggle('hidden', visible > 0);
    grid.classList.toggle('hidden', visible === 0);
  }

  function applySort() {
    const sortVal = sortSelect?.value || 'alpha';
    const sorted = cards().sort((a, b) => {
      if (sortVal === 'alpha') return (a.dataset.title || '').localeCompare(b.dataset.title || '');
      if (sortVal === 'time-asc') return Number(a.dataset.minutes) - Number(b.dataset.minutes);
      if (sortVal === 'time-desc') return Number(b.dataset.minutes) - Number(a.dataset.minutes);
      if (sortVal === 'diff-asc') {
        const order = { beginner: 0, intermediate: 1 };
        return (order[a.dataset.difficulty as keyof typeof order] ?? 0) - (order[b.dataset.difficulty as keyof typeof order] ?? 0);
      }
      if (sortVal === 'diff-desc') {
        const order = { beginner: 0, intermediate: 1 };
        return (order[b.dataset.difficulty as keyof typeof order] ?? 0) - (order[a.dataset.difficulty as keyof typeof order] ?? 0);
      }
      return 0;
    });
    sorted.forEach((card) => grid.appendChild(card));
  }

  function update() {
    applyChipState();
    applyVisibility();
    applySort();
    pushUrlState();
  }

  document.querySelectorAll<HTMLElement>('[data-filter]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter as keyof Filters;
      const value = btn.dataset.value!;

      if (filter === 'difficulty') state.difficulty = value;
      else if (filter === 'time') state.time = value;
      else if (filter === 'supports') {
        state.supports = state.supports === value ? null : value;
      }
      update();
    });
  });

  sortSelect?.addEventListener('change', update);

  resetBtn?.addEventListener('click', () => {
    state = { difficulty: 'all', supports: null, time: 'all' };
    if (sortSelect) sortSelect.value = 'alpha';
    update();
  });

  readUrlState();
  update();
</script>
