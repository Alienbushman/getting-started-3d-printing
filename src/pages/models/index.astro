---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const models = await getCollection('models');
---

<Base title="Model Gallery" description="Beginner-friendly 3D printable models — license-clean and ready to print.">
  <div class="mx-auto max-w-content px-4 md:px-8 lg:px-12 py-12">
    <h1 class="font-display text-3xl font-semibold text-ink mb-8">Model Gallery</h1>
    <p class="text-neutral-500 mb-8">Placeholder — full gallery implementation in a downstream ticket.</p>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {models.map((model) => (
        <li class="border border-neutral-100 rounded-lg p-4">
          <a href={`${import.meta.env.BASE_URL}models/${model.slug}/`} class="font-display font-semibold text-lg text-ink hover:text-accent">
            {model.data.title}
          </a>
          <p class="text-sm text-neutral-500 mt-1">{model.data.description}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>
