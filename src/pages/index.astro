---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Home" description="10 beginner-friendly 3D prints and 8 guides — no fluff.">
  <section class="mx-auto max-w-content px-4 md:px-8 lg:px-12 py-20 text-center">
    <h1 class="font-display text-3xl font-semibold text-ink mb-4">
      Start printing in a day, not a month.
    </h1>
    <p class="text-lg text-neutral-500 mb-8">
      10 beginner-friendly prints + 8 guides, no fluff.
    </p>
    <div class="flex gap-4 justify-center flex-wrap">
      <a
        href={`${base}models/`}
        class="inline-block bg-accent text-white font-semibold text-sm px-5 py-2.5 rounded hover:opacity-90 transition-opacity"
      >
        Browse models
      </a>
      <a
        href={`${base}guide/`}
        class="inline-block border border-ink text-ink font-semibold text-sm px-5 py-2.5 rounded hover:bg-neutral-50 transition-colors"
      >
        Read the guide
      </a>
    </div>
  </section>
</Base>
