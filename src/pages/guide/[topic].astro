---
import Base from '../../layouts/Base.astro';
import GuideToc from '../../components/primitives/GuideToc.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { topic: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content, headings } = await guide.render();

const allGuides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const idx = allGuides.findIndex((g) => g.slug === guide.slug);
const prev = idx > 0 ? allGuides[idx - 1] : null;
const next = idx < allGuides.length - 1 ? allGuides[idx + 1] : null;
const base = import.meta.env.BASE_URL;
const calloutBody = guide.data.callout
  ? guide.data.callout.replace(/^You'll come back to this when\s*/i, '')
  : null;
---

<Base title={guide.data.title} description={`Guide topic ${guide.data.order} of 8: ${guide.data.title}. Est ${guide.data.est_read_time_minutes} min read.`}>
  <div class="mx-auto max-w-content px-4 md:px-8 lg:px-12 py-12">
    <div class="flex items-center justify-between mb-8 text-sm text-neutral-500">
      <a href={`${base}guide/`} class="hover:text-ink">&larr; Guide hub</a>
      <span>Topic {String(guide.data.order).padStart(2, '0')} of 08 &nbsp;·&nbsp; {guide.data.est_read_time_minutes} min read</span>
    </div>

    <div class="lg:grid lg:grid-cols-[1fr_220px] lg:gap-12 xl:gap-16">
      <article>
        <h1 class="font-display text-3xl font-semibold text-ink mb-8">{guide.data.title}</h1>

        <div class="prose-guide">
          <Content />
        </div>

        {calloutBody && (
          <aside class="border-l-4 border-accent bg-accent-soft px-5 py-4 mt-10 rounded-r-lg" role="note">
            <p class="text-sm text-ink"><strong>You'll come back to this when:</strong> {calloutBody}</p>
          </aside>
        )}

        <nav class="flex justify-between mt-12 pt-8 border-t border-neutral-100 gap-4" aria-label="Guide pagination">
          {prev ? (
            <a
              href={`${base}guide/${prev.slug}/`}
              class="group flex flex-col gap-0.5 max-w-[45%]"
            >
              <span class="text-xs text-neutral-500 group-hover:text-ink">&larr; Previous</span>
              <span class="text-sm font-semibold text-ink group-hover:text-accent">{prev.data.title}</span>
            </a>
          ) : <span />}
          {next && (
            <a
              href={`${base}guide/${next.slug}/`}
              class="group flex flex-col gap-0.5 max-w-[45%] text-right ml-auto"
            >
              <span class="text-xs text-neutral-500 group-hover:text-ink">Next &rarr;</span>
              <span class="text-sm font-semibold text-ink group-hover:text-accent">{next.data.title}</span>
            </a>
          )}
        </nav>
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-8">
          <GuideToc headings={headings} />
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .prose-guide {
    max-width: 65ch;
    color: #1A1A1A;
    line-height: 1.7;
    font-size: 16px;
  }
  .prose-guide h2 {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 600;
    font-size: 22px;
    color: #1A1A1A;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .prose-guide h3 {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 600;
    font-size: 18px;
    color: #1A1A1A;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-guide p {
    margin-bottom: 1rem;
    color: #2A2724;
  }
  .prose-guide ul,
  .prose-guide ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  .prose-guide li {
    margin-bottom: 0.4rem;
    color: #2A2724;
  }
  .prose-guide ul li {
    list-style-type: disc;
  }
  .prose-guide ol li {
    list-style-type: decimal;
  }
  .prose-guide strong {
    font-weight: 600;
    color: #1A1A1A;
  }
  .prose-guide a {
    color: #E85D2F;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-guide a:hover {
    opacity: 0.8;
  }
  .prose-guide code {
    font-family: ui-monospace, monospace;
    font-size: 0.875em;
    background: #F4F2EE;
    padding: 0.1em 0.3em;
    border-radius: 3px;
  }
  .prose-guide pre {
    background: #F4F2EE;
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .prose-guide pre code {
    background: none;
    padding: 0;
  }
  .prose-guide table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1rem;
    font-size: 14px;
  }
  .prose-guide th {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid #E5E2DC;
    font-weight: 600;
    font-family: "Space Grotesk", system-ui, sans-serif;
  }
  .prose-guide td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid #E5E2DC;
    color: #2A2724;
  }
  .prose-guide img {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    margin: 1.5rem 0;
  }
  .prose-guide blockquote {
    border-left: 3px solid #E85D2F;
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: #6B675F;
    font-style: italic;
  }
</style>
