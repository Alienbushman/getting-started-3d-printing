---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const totalMinutes = guides.reduce((sum, g) => sum + g.data.est_read_time_minutes, 0);
const base = import.meta.env.BASE_URL;

const essentialOrders = [1, 2, 5, 6, 7];
---

<Base title="Getting Started Guide" description="Eight topics to get you printing on day one.">
  <div class="mx-auto max-w-content px-4 md:px-8 lg:px-12 py-12">
    <h1 class="font-display text-3xl font-semibold text-ink mb-3">Getting started with 3D printing</h1>
    <p class="text-lg text-neutral-500 mb-10">Eight topics. ~{totalMinutes} minutes total. Skip around.</p>

    <ol class="space-y-4">
      {guides.map((guide) => {
        const isEssential = essentialOrders.includes(guide.data.order);
        return (
          <li>
            <a
              href={`${base}guide/${guide.slug}/`}
              class="group flex gap-4 items-start border border-neutral-100 rounded-lg px-5 py-4 hover:border-accent-soft hover:bg-neutral-50 transition-colors"
              aria-label={`${guide.data.title} — ${guide.data.est_read_time_minutes} minute read`}
            >
              <span class="font-display text-2xl font-semibold text-neutral-300 group-hover:text-accent-soft w-10 shrink-0 leading-none mt-0.5 transition-colors">
                {String(guide.data.order).padStart(2, '0')}
              </span>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap gap-2 items-center mb-1">
                  <span class="font-display font-semibold text-lg text-ink group-hover:text-accent transition-colors">
                    {guide.data.title}
                  </span>
                  {isEssential && (
                    <span class="text-xs bg-accent-soft text-accent px-2 py-0.5 rounded font-semibold">Essential</span>
                  )}
                </div>
                <span class="text-sm text-neutral-500">{guide.data.est_read_time_minutes} min read</span>
              </div>
              <span class="text-neutral-300 group-hover:text-accent transition-colors text-xl leading-none mt-1" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</Base>
