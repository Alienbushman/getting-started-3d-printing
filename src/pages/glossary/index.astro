---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const terms = (await getCollection('glossary')).sort((a, b) =>
  a.data.term.localeCompare(b.data.term)
);

const letters = [...new Set(terms.map((t) => t.data.term[0].toUpperCase()))];
const grouped = Object.fromEntries(
  letters.map((letter) => [
    letter,
    terms.filter((t) => t.data.term[0].toUpperCase() === letter),
  ])
);
---

<Base title="Glossary" description="3D printing terms explained simply.">
  <div class="mx-auto max-w-content px-4 md:px-8 lg:px-12 py-12">
    <h1 class="font-display text-3xl font-semibold text-ink mb-6">Glossary</h1>
    <nav aria-label="Alphabet navigation" class="flex flex-wrap gap-2 mb-10">
      {letters.map((letter) => (
        <a href={`#${letter}`} class="text-sm text-neutral-500 hover:text-accent border border-neutral-100 rounded px-2 py-0.5">
          {letter}
        </a>
      ))}
    </nav>
    {letters.map((letter) => (
      <section id={letter} class="mb-10">
        <h2 class="font-display text-2xl font-semibold text-ink mb-4 border-b border-neutral-100 pb-2">{letter}</h2>
        <dl class="space-y-4">
          {grouped[letter].map((entry) => (
            <div>
              <dt class="font-semibold text-ink">{entry.data.term}</dt>
              <dd class="text-sm text-neutral-500 mt-0.5">{entry.data.definition}</dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>
</Base>
