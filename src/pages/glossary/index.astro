---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const terms = (await getCollection('glossary')).sort((a, b) =>
  a.data.term.localeCompare(b.data.term)
);

const letters = [...new Set(terms.map((t) => t.data.term[0].toUpperCase()))].sort();
const grouped = Object.fromEntries(
  letters.map((letter) => [
    letter,
    terms.filter((t) => t.data.term[0].toUpperCase() === letter),
  ])
);

const slugMap = Object.fromEntries(terms.map((t) => [t.slug, t.data.term]));
const base = import.meta.env.BASE_URL;
---

<Base title="Glossary" description="3D printing terms explained for beginners — FDM, slicer, G-code, and more.">
  <div class="mx-auto max-w-content px-4 md:px-8 lg:px-12 py-12">
    <h1 class="font-display text-3xl font-semibold text-ink mb-3">Glossary</h1>
    <p class="text-neutral-500 mb-8">{terms.length} terms. All beginner-targeted.</p>

    <nav aria-label="Alphabet navigation" class="flex flex-wrap gap-2 mb-12 sticky top-0 bg py-3 border-b border-neutral-100 z-10">
      {letters.map((letter) => (
        <a
          href={`#letter-${letter}`}
          class="text-sm font-display font-semibold text-neutral-500 hover:text-accent border border-neutral-100 hover:border-accent rounded px-2.5 py-1 transition-colors"
        >
          {letter}
        </a>
      ))}
    </nav>

    {letters.map((letter) => (
      <section id={`letter-${letter}`} class="mb-12 scroll-mt-20">
        <h2 class="font-display text-2xl font-semibold text-ink mb-6 pb-2 border-b border-neutral-100">{letter}</h2>
        <dl class="space-y-6">
          {grouped[letter].map((entry) => (
            <div id={entry.slug} class="scroll-mt-4">
              <dt class="font-display font-semibold text-lg text-ink mb-1">{entry.data.term}</dt>
              <dd class="text-base text-neutral-900 leading-relaxed mb-2">{entry.data.definition}</dd>
              {entry.data.gotcha && (
                <p class="text-sm border-l-4 border-warning bg-neutral-50 px-3 py-2 rounded-r text-neutral-900 mb-2">
                  <strong class="text-warning">Watch out:</strong> {entry.data.gotcha}
                </p>
              )}
              {entry.data.see_also && entry.data.see_also.length > 0 && (
                <p class="flex flex-wrap gap-2 items-center mt-2">
                  <span class="text-xs text-neutral-500">See also:</span>
                  {entry.data.see_also.map((slug) => (
                    <a
                      href={`#${slug}`}
                      class="text-xs border border-neutral-100 hover:border-accent hover:text-accent rounded px-2 py-0.5 text-neutral-500 transition-colors"
                    >
                      {slugMap[slug] ?? slug}
                    </a>
                  ))}
                </p>
              )}
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>
</Base>
